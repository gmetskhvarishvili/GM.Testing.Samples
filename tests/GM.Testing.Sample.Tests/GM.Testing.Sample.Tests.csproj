<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>

        <!--
          Warnings are errors here too (inherited from Directory.Build.props). CA1707 is relaxed for
          test code only: the mandated test name style is Method_Scenario_ExpectedResult, which uses
          underscores by design.
        -->
        <NoWarn>$(NoWarn);CA1707</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <!--
      Published-package references — the shape the sample ships in once the GM.Testing packages are
      live on nuget.org. For local development against the sibling source repo, use the ProjectReference
      form on the feat/testing-sample branch instead.
    -->
    <ItemGroup>
        <PackageReference Include="GM.Testing" Version="1.0.1" />
        <PackageReference Include="GM.Testing.AspNetCore" Version="1.0.1" />
        <PackageReference Include="GM.Testing.Fakes" Version="1.0.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\GM.Testing.Sample.API\GM.Testing.Sample.API.csproj" />
    </ItemGroup>

</Project>
